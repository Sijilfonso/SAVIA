<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/savia_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Avatar/placeholder -->
        <ImageView
            android:id="@+id/ivStoreImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ic_launcher_round"
            android:backgroundTint="@color/savia_green_light"
            android:contentDescription="@string/app_name"
            android:padding="12dp"
            android:src="@drawable/ic_home"
            android:tint="@color/savia_white" />

        <!-- Nombre negocio -->
        <TextView
            android:id="@+id/tvStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textAlignment="center"
            android:textColor="@color/savia_text_primary"
            android:textSize="14sp" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/tvStoreCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="center"
            android:textColor="@color/savia_text_secondary"
            android:textSize="12sp" />

        <!-- Zona -->
        <TextView
            android:id="@+id/tvStoreZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="center"
            android:textColor="@color/savia_text_hint"
            android:textSize="11sp" />

        <!-- Tipo entidad (traducido) -->
        <TextView
            android:id="@+id/tvEntityType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/savia_white"
            android:textSize="11sp" />

        <!-- Badges row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFeaturedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/savia_gold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Destacado"
                android:textColor="@color/savia_white"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVerifiedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@color/status_blue"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="✓ Verificado"
                android:textColor="@color/savia_white"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
